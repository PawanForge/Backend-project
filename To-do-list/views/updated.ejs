
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Update To-Do</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f4f6f8;

            min-height: 100vh;

            display: flex;
            justify-content: center;
            align-items: center;
        }

        .update-container {
            width: 100%;
            max-width: 500px;

            background-color: white;

            padding: 30px;

            border-radius: 12px;

            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        }

        h1 {
            text-align: center;

            margin-bottom: 25px;

            color: #222;
        }

        .update-form {
            display: flex;

            flex-direction: column;

            gap: 10px;
        }

        label {
            font-weight: bold;

            color: #444;
        }

        input {
            width: 100%;

            padding: 12px 14px;

            font-size: 16px;

            border: 1px solid #ccc;

            border-radius: 7px;

            outline: none;
        }

        input:focus {
            border-color: #4f46e5;
        }

        .update-btn {
            margin-top: 10px;

            padding: 12px;

            background-color: #4f46e5;

            color: white;

            border: none;

            border-radius: 7px;

            font-size: 16px;

            cursor: pointer;
        }

        .update-btn:hover {
            background-color: #3730a3;
        }

        .back-btn {
            display: block;

            width: fit-content;

            margin: 20px auto 0;

            padding: 10px 18px;

            background-color: #6b7280;

            color: white;

            text-decoration: none;

            border-radius: 7px;
        }

        .back-btn:hover {
            background-color: #4b5563;
        }

    </style>

</head>

<body>

    <div class="update-container">

        <h1>Update To-Do</h1>

        <form
            action="/update/<%= todo._id %>"
            method="POST"
            class="update-form"
        >

            <label for="content">
                Task
            </label>

            <input
                type="text"
                id="content"
                name="content"
                value="<%= todo.content %>"
                required
            >

            <button
                type="submit"
                class="update-btn"
            >
                Update
            </button>

        </form>

        <a
            href="/"
            class="back-btn"
        >
            Back
        </a>

    </div>

</body>

</html>
