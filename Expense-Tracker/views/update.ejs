<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Transaction - Expense Tracker</title>
    <link rel="stylesheet" href="/UI.css">
</head>

<body>

    <div class="container">

        <!-- ================= HEADER ================= -->
        <header class="header">
            <div>
                <h1>Edit Transaction</h1>
                <p>Modify and update your expense or income record</p>
            </div>
            <a href="/" class="cancel-btn">← Back to Dashboard</a>
        </header>

        <!-- ================= ERROR ALERT ================= -->
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error">
                <span class="alert-icon">⚠</span>
                <span><%= error %></span>
            </div>
        <% } %>

        <!-- ================= EDIT FORM SECTION ================= -->
        <section class="form-section">
            <div class="section-title">
                <h2>Update Details</h2>
                <p>Change the fields below and click "Update Transaction" to save to MongoDB.</p>
            </div>

            <!-- Compute safe date format (YYYY-MM-DD) for HTML5 input -->
            <%
                let dateValue = "";
                if (transaction.date) {
                    if (typeof transaction.date === "string" && transaction.date.includes("T")) {
                        dateValue = transaction.date.split("T")[0];
                    } else if (typeof transaction.date === "string" && transaction.date.length === 10) {
                        dateValue = transaction.date;
                    } else {
                        const parsed = new Date(transaction.date);
                        if (!isNaN(parsed.getTime())) {
                            dateValue = parsed.toISOString().split("T")[0];
                        }
                    }
                }
            %>

            <form
                action="/transactions/update/<%= transaction._id %>"
                method="POST"
                class="transaction-form"
            >
                <div class="form-grid">
                    <!-- Title / Name -->
                    <div class="form-group">
                        <label for="title">Title / Name *</label>
                        <input
                            type="text"
                            id="title"
                            name="title"
                            value="<%= transaction.title %>"
                            required
                            maxlength="100"
                        >
                    </div>

                    <!-- Amount -->
                    <div class="form-group">
                        <label for="amount">Amount (₹) *</label>
                        <input
                            type="number"
                            id="amount"
                            name="amount"
                            value="<%= transaction.amount %>"
                            min="0.01"
                            step="0.01"
                            required
                        >
                    </div>

                    <!-- Type -->
                    <div class="form-group">
                        <label for="type">Type *</label>
                        <select id="type" name="type" required>
                            <option
                                value="expense"
                                <%= transaction.type === 'expense' ? 'selected' : '' %>
                            >
                                Expense
                            </option>
                            <option
                                value="income"
                                <%= transaction.type === 'income' ? 'selected' : '' %>
                            >
                                Income
                            </option>
                        </select>
                    </div>

                    <!-- Category -->
                    <div class="form-group">
                        <label for="category">Category</label>
                        <select id="category" name="category">
                            <option value="Food" <%= transaction.category === 'Food' ? 'selected' : '' %>>Food & Dining</option>
                            <option value="Travel" <%= transaction.category === 'Travel' ? 'selected' : '' %>>Travel & Fuel</option>
                            <option value="Shopping" <%= transaction.category === 'Shopping' ? 'selected' : '' %>>Shopping</option>
                            <option value="Bills" <%= transaction.category === 'Bills' ? 'selected' : '' %>>Bills & Utilities</option>
                            <option value="Salary" <%= transaction.category === 'Salary' ? 'selected' : '' %>>Salary / Earning</option>
                            <option value="Health" <%= transaction.category === 'Health' ? 'selected' : '' %>>Health & Fitness</option>
                            <option value="Other" <%= transaction.category === 'Other' || !transaction.category ? 'selected' : '' %>>Other</option>
                        </select>
                    </div>

                    <!-- Date -->
                    <div class="form-group">
                        <label for="date">Date *</label>
                        <input
                            type="date"
                            id="date"
                            name="date"
                            value="<%= dateValue %>"
                            required
                        >
                    </div>

                    <!-- Description -->
                    <div class="form-group full-width">
                        <div class="desc-header">
                            <label for="description">Description (Optional)</label>
                            <button type="button" class="ai-inline-btn" id="aiDescBtn" title="Regenerate or suggest description with AI">
                                ✨ Generate with AI
                            </button>
                        </div>
                        <textarea
                            id="description"
                            name="description"
                            rows="3"
                            placeholder="Add extra notes or details"
                        ><%= transaction.description || '' %></textarea>
                    </div>
                </div>

                <!-- Form Action Buttons -->
                <div class="form-actions">
                    <button type="submit" class="add-btn">
                        Update Transaction
                    </button>
                    <a href="/" class="cancel-btn">
                        Cancel
                    </a>
                </div>
            </form>
        </section>

        <!-- ================= FOOTER ================= -->
        <footer class="footer">
            <p>Expense Tracker App • Powered by Node.js, Express & MongoDB • © <%= new Date().getFullYear() %></p>
        </footer>

    </div>

    <!-- Client-side AI Controller -->
    <script src="/client-ai.js"></script>
</body>

</html>