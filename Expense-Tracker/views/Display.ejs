
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Expense Tracker</title>

    <link rel="stylesheet" href="/UI.css">
</head>

<body>

    <div class="container">

        <!-- ================= HEADER ================= -->

        <header class="header">

            <div>
                <h1>Expense Tracker</h1>
                <p>Manage your income and expenses easily</p>
            </div>

        </header>


        <!-- ================= SUMMARY ================= -->

        <section class="summary">

            <!-- Balance -->

            <div class="summary-card balance-card">

                <div class="card-label">
                    Current Balance
                </div>

                <h2>
                    ₹<%= Number(balance || 0).toFixed(2) %>
                </h2>

            </div>


            <!-- Income -->

            <div class="summary-card income-card">

                <div class="card-label">
                    Total Income
                </div>

                <h2>
                    ₹<%= Number(totalIncome || 0).toFixed(2) %>
                </h2>

            </div>


            <!-- Expense -->

            <div class="summary-card expense-card">

                <div class="card-label">
                    Total Expenses
                </div>

                <h2>
                    ₹<%= Number(totalExpense || 0).toFixed(2) %>
                </h2>

            </div>

        </section>


        <!-- ================= ADD TRANSACTION ================= -->

        <section class="form-section">

            <div class="section-title">

                <h2>Add Transaction</h2>

                <p>
                    Add your income or expense details.
                </p>

            </div>


            <form
                action="/transactions"
                method="POST"
                class="transaction-form"
            >

                <div class="form-grid">

                    <!-- Name -->

                    <div class="form-group">

                        <label for="title">
                            Name
                        </label>

                        <input
                            type="text"
                            id="title"
                            name="title"
                            placeholder="e.g. Grocery"
                            required
                        >

                    </div>


                    <!-- Amount -->

                    <div class="form-group">

                        <label for="amount">
                            Amount
                        </label>

                        <input
                            type="number"
                            id="amount"
                            name="amount"
                            placeholder="Enter amount"
                            min="0"
                            step="0.01"
                            required
                        >

                    </div>


                    <!-- Type -->

                    <div class="form-group">

                        <label for="type">
                            Type
                        </label>

                        <select
                            id="type"
                            name="type"
                            required
                        >

                            <option value="">
                                Select Type
                            </option>

                            <option value="income">
                                Income
                            </option>

                            <option value="expense">
                                Expense
                            </option>

                        </select>

                    </div>


                    <!-- Category -->

                    <div class="form-group">

                        <label for="category">
                            Category
                        </label>

                        <select
                            id="category"
                            name="category"
                        >

                            <option value="">
                                Select Category
                            </option>

                            <option value="Food">
                                Food
                            </option>

                            <option value="Travel">
                                Travel
                            </option>

                            <option value="Shopping">
                                Shopping
                            </option>

                            <option value="Bills">
                                Bills
                            </option>

                            <option value="Salary">
                                Salary
                            </option>

                            <option value="Other">
                                Other
                            </option>

                        </select>

                    </div>


                    <!-- Date -->

                    <div class="form-group">

                        <label for="date">
                            Date
                        </label>

                        <input
                            type="date"
                            id="date"
                            name="date"
                            required
                        >

                    </div>

                </div>


                <!-- Description -->

                <div class="form-group">

                    <label for="description">
                        Description
                    </label>

                    <textarea
                        id="description"
                        name="description"
                        rows="3"
                        placeholder="Enter description (optional)"
                    ></textarea>

                </div>


                <button
                    type="submit"
                    class="add-btn"
                >
                    + Add Transaction
                </button>

            </form>

        </section>


        <!-- ================= EXPENSE LIST ================= -->

        <section class="expense-section">

            <div class="section-title">

                <h2>Expense List</h2>

                <p>
                    All your expenses are listed below.
                </p>

            </div>


            <% if (transactions && transactions.length > 0) { %>

                <div class="table-wrapper">

                    <table class="expense-table">

                        <thead>

                            <tr>

                                <th>#</th>

                                <th>Expense Name</th>

                                <th>Amount</th>

                                <th>Category</th>

                                <th>Date</th>

                                <th>Description</th>

                                <th>Action</th>

                            </tr>

                        </thead>


                        <tbody>

                            <% let expenseNumber = 1; %>


                            <% transactions.forEach(transaction => { %>

                                <% if (transaction.type === 'expense') { %>

                                    <tr>

                                        <!-- Number -->

                                        <td class="number-cell">

                                            <%= expenseNumber++ %>

                                        </td>


                                        <!-- Name -->

                                        <td>

                                            <div class="expense-name">

                                                <strong>
                                                    <%= transaction.title %>
                                                </strong>

                                            </div>

                                        </td>


                                        <!-- Amount -->

                                        <td>

                                            <span class="expense-amount">

                                                - ₹<%= Number(transaction.amount).toFixed(2) %>

                                            </span>

                                        </td>


                                        <!-- Category -->

                                        <td>

                                            <span class="category-badge">

                                                <%= transaction.category || 'Other' %>

                                            </span>

                                        </td>


                                        <!-- Date -->

                                        <td>

                                            <%= new Date(transaction.date).toLocaleDateString('en-IN') %>

                                        </td>


                                        <!-- Description -->

                                        <td class="description-cell">

                                            <%= transaction.description || '-' %>

                                        </td>


                                        <!-- Actions -->

                                        <td>

                                            <div class="action-buttons">

                                                <a
                                                    href="/transactions/edit/<%= transaction._id %>"
                                                    class="edit-btn"
                                                >
                                                    Edit
                                                </a>


                                                <form
                                                    action="/transactions/delete/<%= transaction._id %>"
                                                    method="POST"
                                                    onsubmit="return confirm('Are you sure you want to delete this expense?');"
                                                >

                                                    <button
                                                        type="submit"
                                                        class="delete-btn"
                                                    >
                                                        Delete
                                                    </button>

                                                </form>

                                            </div>

                                        </td>

                                    </tr>

                                <% } %>

                            <% }) %>

                        </tbody>

                    </table>

                </div>


            <% } else { %>

                <!-- Empty State -->

                <div class="empty-state">

                    <div class="empty-icon">
                        💰
                    </div>

                    <h3>
                        No Expenses Found
                    </h3>

                    <p>
                        Add your first expense to start tracking your money.
                    </p>

                </div>

            <% } %>

        </section>


        <!-- OVERALL SUMMARY--> 

        <section class="overall-section">

            <div class="section-title">

                <h2>Overall Summary</h2>

                <p>
                    Your complete financial overview.
                </p>

            </div>


            <div class="overall-grid">


                <!-- Income -->

                <div class="overall-item">

                    <span>
                        Total Income
                    </span>

                    <strong class="overall-income">

                        ₹<%= Number(totalIncome || 0).toFixed(2) %>

                    </strong>

                </div>


                <!-- Expense -->

                <div class="overall-item">

                    <span>
                        Total Expenses
                    </span>

                    <strong class="overall-expense">

                        ₹<%= Number(totalExpense || 0).toFixed(2) %>

                    </strong>

                </div>


                <!-- Balance -->

                <div class="overall-item">

                    <span>
                        Final Balance
                    </span>

                    <strong class="overall-balance">

                        ₹<%= Number(balance || 0).toFixed(2) %>

                    </strong>

                </div>


            </div>

        </section>


        <!-- ================= FOOTER ================= -->

        <footer class="footer">

            <p>
                Expense Tracker © <%= new Date().getFullYear() %>
            </p>

        </footer>

    </div>

</body>

</html>