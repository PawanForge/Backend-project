
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Contact Manager</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>


<body>

    <div class="container">


        <!-- Header -->

        <div class="header">

            <div>

                <h1>
                    Contact Manager
                </h1>

                <p>
                    Manage your contacts easily
                </p>

            </div>

        </div>



        <!-- ================================
             SEARCH CONTACT
        ================================= -->

        <div class="search-card">

            <div class="search-header">

                <div>

                    <h2>
                        Search Contacts
                    </h2>

                    <p>
                        Search contact by first name
                    </p>

                </div>

            </div>


            <form
                action="/search"
                method="GET"
                class="search-form"
            >

                <div class="search-input-wrapper">

                    <span class="search-icon">
                        🔍
                    </span>

                    <input
                        type="text"
                        name="name"
                        placeholder="Search by first name..."
                        required
                    >

                </div>


                <button
                    type="submit"
                    class="search-btn"
                >
                    Search
                </button>

            </form>

        </div>



        <!-- Add Contact Card -->

        <div class="form-card">

            <div class="card-header">

                <h2>
                    Add New Contact
                </h2>

                <p>
                    Enter the contact details below
                </p>

            </div>


            <form
                action="/contacts"
                method="POST"
            >


                <!-- First Name -->

                <div class="form-group">

                    <label for="firstName">
                        First Name
                    </label>

                    <input
                        type="text"
                        id="firstName"
                        name="firstName"
                        placeholder="Enter first name"
                        required
                    >

                </div>



                <!-- Contact Number -->

                <div class="form-group">

                    <label for="contactNumber">
                        Contact Number
                    </label>

                    <input
                        type="tel"
                        id="contactNumber"
                        name="contactNumber"
                        placeholder="Enter 10-digit contact number"
                        maxlength="10"
                        pattern="[0-9]{10}"
                        required
                    >

                </div>



                <!-- Professional Field -->

                <div class="form-group">

                    <label for="professional">
                        Professional Field
                    </label>


                    <select
                        id="professional"
                        name="professional"
                        required
                    >

                        <option value="">
                            Select Professional Field
                        </option>

                        <option value="IT">
                            IT
                        </option>

                        <option value="Management">
                            Management
                        </option>

                        <option value="Finance">
                            Finance
                        </option>

                        <option value="Marketing">
                            Marketing
                        </option>

                        <option value="Sales">
                            Sales
                        </option>

                        <option value="Education">
                            Education
                        </option>

                        <option value="Healthcare">
                            Healthcare
                        </option>

                        <option value="Business">
                            Business
                        </option>

                        <option value="Other">
                            Other
                        </option>

                    </select>

                </div>



                <!-- Submit Button -->

                <button
                    type="submit"
                    class="btn btn-primary"
                >
                    + Add Contact
                </button>


            </form>

        </div>



        <!-- Contacts Card -->

        <div class="contacts-card">


            <div class="card-header contact-header">

                <div>

                    <h2>
                        My Contacts
                    </h2>

                    <p>
                        Your saved contacts
                    </p>

                </div>


                <% if (contacts && contacts.length > 0) { %>

                    <span class="contact-count">

                        <%= contacts.length %>
                        Contacts

                    </span>

                <% } %>


            </div>



            <!-- Contacts Table -->


            <% if (contacts && contacts.length > 0) { %>


                <div class="table-wrapper">

                    <table>

                        <thead>

                            <tr>

                                <th>
                                    #
                                </th>

                                <th>
                                    First Name
                                </th>

                                <th>
                                    Contact Number
                                </th>

                                <th>
                                    Professional Field
                                </th>

                                <th>
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>


                            <% contacts.forEach((contact, index) => { %>


                                <tr>


                                    <!-- Number -->

                                    <td class="serial">

                                        <%= index + 1 %>

                                    </td>



                                    <!-- Name -->

                                    <td>

                                        <div class="name-box">

                                            <div class="avatar">

                                                <%= contact.firstName
                                                    .charAt(0)
                                                    .toUpperCase()
                                                %>

                                            </div>


                                            <span>

                                                <%= contact.firstName %>

                                            </span>

                                        </div>

                                    </td>



                                    <!-- Contact Number -->

                                    <td>

                                        <%= contact.contactNumber %>

                                    </td>



                                    <!-- Professional -->

                                    <td>

                                        <span class="profession">

                                            <%= contact.professional %>

                                        </span>

                                    </td>



                                    <!-- Actions -->

                                    <td>

                                        <div class="actions">


                                            <!-- Edit -->

                                            <a
                                                href="/contacts/edit/<%= contact._id %>"
                                                class="btn-edit"
                                            >
                                                Edit
                                            </a>



                                            <!-- Delete -->

                                            <form
                                                action="/contacts/delete/<%= contact._id %>"
                                                method="POST"
                                                onsubmit="return confirm('Are you sure you want to delete this contact?');"
                                            >

                                                <button
                                                    type="submit"
                                                    class="btn-delete"
                                                >
                                                    Delete
                                                </button>

                                            </form>


                                        </div>

                                    </td>


                                </tr>


                            <% }) %>


                        </tbody>

                    </table>

                </div>


            <% } else { %>


                <!-- Empty State -->

                <div class="empty">

                    <div class="empty-icon">
                        📇
                    </div>

                    <h3>
                        No Contacts Found
                    </h3>

                    <p>
                        You haven't added any contacts yet.
                    </p>

                </div>


            <% } %>


        </div>


    </div>

</body>

</html>
