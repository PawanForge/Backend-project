
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Note</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

    <div class="edit-container">

        <h1>Edit Note</h1>

        <form
            action="/update/<%= note._id %>"
            method="POST"
            class="edit-form"
        >

            <input
                type="text"
                name="note"
                value="<%= note.note %>"
                required
            >

            <div class="edit-buttons">

                <button
                    type="submit"
                    class="update"
                >
                    Update
                </button>

                <a
                    href="/"
                    class="back"
                >
                    Back
                </a>

            </div>

        </form>

    </div>

</body>

</html>
